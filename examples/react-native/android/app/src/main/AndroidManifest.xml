<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:label="Tester Swarm React Native Example"
        android:usesCleartextTraffic="true">
        <meta-data
            android:name="dev.testerswarm.APP_KEY"
            android:value="ts_pk_example_rn_0001" />
        <meta-data
            android:name="dev.testerswarm.API_URL"
            android:value="http://10.0.2.2:54321/functions/v1" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
